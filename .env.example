# =============================================================================
# EXEMPLO DE CONFIGURAÇÃO DE AMBIENTE
# =============================================================================
# Copie para ".env.local" e preencha com os dados do seu projeto Sanity.
# O ".env.local" NÃO é versionado (fica fora do Git).
#
# Crie um projeto grátis em https://www.sanity.io/manage e pegue o Project ID.
# =============================================================================

NEXT_PUBLIC_SANITY_PROJECT_ID="placeholder"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2025-01-01"

# URL pública do site (SEO: sitemap, robots, compartilhamento).
NEXT_PUBLIC_SITE_URL="https://anacordeiro-arquitetura.vercel.app"

# -----------------------------------------------------------------------------
# FORMULÁRIO DE CONTATO (segredo — NÃO usar prefixo NEXT_PUBLIC)
# -----------------------------------------------------------------------------
# Token de ESCRITA do Sanity, para gravar as mensagens no painel.
# Crie em: sanity.io/manage → projeto → API → Tokens → permissão "Editor".
SANITY_API_WRITE_TOKEN=""
